#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Git runs hooks with its own environment exported: in a linked worktree GIT_DIR is the absolute
# path of this repository. Tools that call git on another repository inherit it: with an empty
# build/SourcePackages, xcodebuild's checkout of Sparkle then reads this repository instead and
# fails with "unable to read tree", so the first push from every new worktree was blocked.
# From the top level git finds this checkout by itself, so the variables are dropped here.
unset $(git rev-parse --local-env-vars)

head=$(git rev-parse HEAD)
verify=false
while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote ref sends no code to validate.
    [[ "$local_sha" =~ ^0+$ ]] && continue
    if [[ "$local_sha" != "$head" ]]; then
        echo "Push blocked: check out the commit being pushed and verify it there." >&2
        exit 1
    fi
    verify=true
done
$verify || exit 0

check_tree() {
    if [[ -n "$(git status --porcelain --untracked-files=normal)" ]] || [[ "$(git rev-parse HEAD)" != "$head" ]]; then
        echo "Push blocked: HEAD and working tree must remain clean throughout verification." >&2
        exit 1
    fi
}
check_tree
bash scripts/verify.sh
check_tree
